{{- /*
  站点配置里 home 的 outputs 含 JSON，原来的 PaperMod 用 index.json 模板实现它。
  换成新主题后如果不提供这个模板，构建会报 "found no layout file for json"，
  而且线上本来就存在的 /index.json 会消失（外部工具/脚本可能在用）。
  这里保留同名产物，并让它同时充当搜索页的数据源：
  字段（title/url/date/tags/cats/summary/content）和 assets/js/sakura.js 里读的一致。
*/ -}}
{{- $main := index (site.Params.mainSections | default (slice "posts")) 0 }}
{{- $out := slice }}
{{- range where site.RegularPages "Section" $main }}
  {{- $out = $out | append (dict
      "title" .Title
      "url" .RelPermalink
      "date" (.Date.Format "2006-01-02")
      "tags" (delimit (.Params.tags | default slice) " ")
      "cats" (delimit (.Params.categories | default slice) " ")
      "summary" (.Summary | plainify | replaceRE `\s+` " " | truncate 140)
      "content" (.Plain | replaceRE `\s+` " " | truncate 1200)
  ) }}
{{- end }}
{{- /* 合集页也放进搜索索引：taxonomy 页不在 RegularPages 里，得单独捞一遍，
       否则搜「合集名」搜不到那一页。字段与文章保持一致，content 用导语 + 篇名拼出来，
       这样搜文章标题也能命中对应合集。 */ -}}
{{- range site.Taxonomies.series }}
  {{- $pages := .Pages }}
  {{- $titles := slice }}
  {{- range $pages }}{{ $titles = $titles | append .Title }}{{ end }}
  {{- $desc := .Page.Description | default (printf "共 %d 篇" (len $pages)) }}
  {{- $out = $out | append (dict
      "title" (printf "合集：%s" .Page.Title)
      "url" .Page.RelPermalink
      "date" (.Page.Lastmod.Format "2006-01-02")
      "tags" "合集 series"
      "cats" ""
      "summary" $desc
      "content" (printf "%s %s" $desc (delimit $titles " "))
  ) }}
{{- end }}
{{- $out | jsonify }}
